# MavJex Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Server Port (Render sets this automatically via the PORT env var)
PORT=3001
NODE_ENV=production

# Alpaca Paper Trading Credentials (Optional: used for live paper execution if configured)
# Sign up at https://alpaca.markets/ to obtain free sandbox paper keys.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# Portfolio State Persistence Path
PERSIST_PATH=.paper-portfolio.json

# CORS Allowed Origin (Default allows all for public paper trading frontend)
ALLOWED_ORIGIN=*
